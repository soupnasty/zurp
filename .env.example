# Database (Neon)
DATABASE_URL=

# Auth (NextAuth v5)
AUTH_SECRET=
AUTH_RESEND_KEY=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Encryption (64-char hex string for AES-256-GCM)
ENCRYPTION_KEY=

# Cron
CRON_SECRET=

# Sandbox mode (set to "true" to enable /sandbox page)
NEXT_PUBLIC_ENABLE_SANDBOX=
